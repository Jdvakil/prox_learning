# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.eggs/
build/
dist/

# Repo-specific large artifacts
runs/                       # training outputs (checkpoints, logs, plots)
data/                       # HDF5 trajectory shards (collected, not committed)
reports/logs/*.log          # collection / training logs
reports/checks/             # sanity-check scratch outputs

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# MuJoCo / mesh caches (legacy fr3_skin_mujoco location, kept for safety)
fr3_skin_mujoco/.mj-install/**
fr3_skin_mujoco/.mesh_cache/**
.mj-install/
.mesh_cache/

# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/figures/_synth_run/

# Keep .gitkeep markers
!**/.gitkeep
assets/**
runs/**
wandb/**
logs/**
act_style_data/**
eval_output/**
analysis_output/
rollout_output/
experiments_output/

# Training checkpoints, ~340 MB each and hundreds of them. The ACT fork ignores its
# own ckpts/ already; this covers any that land in the parent repo.
ckpts/
*.ckpt

# Stray run logs. blur_eval.log (5.3 MB) was committed once by accident.
*.log

# Archived eval metrics ARE tracked. eval_output/ is ignored above, so these 244 KB of
# eval_summary.json are the only durable record of every published number.
!reports/eval_summaries/
!reports/eval_summaries/*.json

data/**
