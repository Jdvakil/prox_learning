# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.eggs/
build/
dist/

# Repo-specific large artifacts
runs/                       # training outputs (checkpoints, logs, plots)
data/                       # HDF5 trajectory shards (collected, not committed)
reports/logs/*.log          # collection / training logs
reports/checks/             # sanity-check scratch outputs

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# MuJoCo / mesh caches (legacy fr3_skin_mujoco location, kept for safety)
fr3_skin_mujoco/.mj-install/**
fr3_skin_mujoco/.mesh_cache/**
.mj-install/
.mesh_cache/

# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/figures/_synth_run/

# Keep .gitkeep markers
!**/.gitkeep
assets/**
runs/**
wandb/**
logs/**
act_style_data/**
eval_output/**
analysis_output/
rollout_output/
experiments_output/

# hybrid_obstacle_independent_v2 smoke output: H5s, videos and per-row payloads
# are bulk artifacts, not source. The JSON reports beside them are committed.
diagnostics_output/hybrid_obstacle_seeding/smoke_runs/
diagnostics_output/hybrid_obstacle_seeding/smoke_runs_invalidated_v1/
assets/reference_data/

# Attempt-3 place-corridor replay MP4s are generated locally and not source.
diagnostics_output/pact_place_corridor_v3_videos/*.mp4
diagnostics_output/pact_place_corridor_v5_videos/*.mp4
diagnostics_output/pact_place_corridor_v6b_videos/*.mp4
diagnostics_output/pact_place_corridor_v6c_videos/*.mp4
diagnostics_output/pact_place_corridor_v7_design_review/**/*.mp4
diagnostics_output/pact_place_corridor_v7_videos/*.mp4

# Replay payloads: full 916-dim model qpos per step, regenerable from the
# frozen seeds. The result.json reports beside them are committed.
diagnostics_output/**/expert_screen_rows/**/trajectory.json

# Per-row result.json are bulk payloads, not reports: runs predating
# PACT_CONTACT_AUDIT_SUMMARY_ONLY retain every contact frame and reach 43-71 MB
# each. The screen summaries beside them (expert_screen.json, analysis.json,
# design_review.json, probe_outcome.json) carry the per-episode findings and
# are committed.
diagnostics_output/**/expert_screen_rows/**/result.json
